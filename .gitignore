# ==========================================
# .gitignore of the DTCWT popularity project
# ==========================================

# Private working files (never published)
_private/

# ==========================================
# DATA FILES - large, not kept in Git
# ==========================================

# Raw data
data/raw/
data/raw/*

# Converted data
data/datasets/
data/datasets/*

# Temporary files
data/temp/
data/tmp/

# Large files
*.csv
*.tsv
*.dat
*.txt
*.parquet
*.feather
*.hdf

# Exceptions - these files are allowed
!requirements.txt
!README.txt
!README.md

# ==========================================
# RESULTS - experiment results
# ==========================================

results/
results/*

# Models
models/
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib

# Images and plots
figures/
*.png
*.jpg
*.jpeg
*.svg
*.pdf

# Exception: documentation images
!docs/images/*.png
!docs/images/*.jpg

# MLflow
mlruns/
mlartifacts/

# ==========================================
# PYTHON
# ==========================================

# Cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Testing
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# pyenv
.python-version

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ==========================================
# IDEs
# ==========================================

# PyCharm
.idea/
*.iml
*.iws

# VSCode
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ==========================================
# OS FILES
# ==========================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ==========================================
# LOGS & TEMP FILES
# ==========================================

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# ==========================================
# DATABASE
# ==========================================

*.db
*.sqlite

# ==========================================
# KEEP DIRECTORY STRUCTURE
# ==========================================

# Keep these files
!.gitkeep
!*/.gitkeep
!README.md
!*/README.md
